{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "my-ratio",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-10-19",
  // Needed for OAuth clients that identify themselves with a metadata URL.
  "compatibility_flags": ["global_fetch_strictly_public"],
  "observability": { "enabled": true },
  // Hourly: the anonymous daily check-in (at most once a day; off switch in Settings), and
  // notifications at 8 a.m. in each device's own time zone.
  "triggers": { "crons": ["41 * * * *"] },
  "upload_source_maps": true,
  "assets": {
    // Static SPA. Unknown paths fall back to index.html; /api/* always reaches the Worker.
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/mcp",
      "/mcp/*",
      "/authorize",
      "/oauth/*",
      "/.well-known/*",
      "/upload/*",
    ],
  },
  "d1_databases": [
    {
      // No database_id: the Deploy button and `wrangler deploy` provision it automatically.
      "binding": "DB", "database_id": "66273234-0edb-4812-8506-6cde2fe8ee3d",
      "database_name": "my-ratio",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    {
      // Bean photos and roaster logos. Created on first deploy if it doesn't exist.
      "binding": "IMAGES",
      "bucket_name": "my-ratio-images",
    },
  ],
  "kv_namespaces": [
    {
      // Sign-ins for AI assistants connected over MCP. Provisioned automatically on deploy.
      "binding": "OAUTH_KV", "id": "6da2cdc7068f479d8ba9d4a94d92d70b",
    },
  ],
}
