{
  "name": "ratio",
  "version": "1.0.0",
  "private": true,
  "description": "A coffee brewing log you host yourself on Cloudflare.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build && npm run release",
    "release": "tsx scripts/release.ts",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "cf-typegen": "wrangler types src/worker/worker-configuration.d.ts",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.worker.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "icons": "tsx scripts/generate-icons.ts"
  },
  "cloudflare": {
    "bindings": {
      "APP_PASSWORD": {
        "description": "The password you sign in to Ratio with. Pick something long; you can change it later in the Cloudflare dashboard under **Workers → ratio → Settings → Variables and Secrets**."
      },
      "DB": {
        "description": "Where your roasters, beans and brews are stored."
      },
      "IMAGES": {
        "description": "Stores bean photos and roaster logos."
      },
      "OAUTH_KV": {
        "description": "Stores sign-ins for AI assistants you connect to Ratio over MCP."
      }
    }
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "1.2.3",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@modelcontextprotocol/server": "2.3.1",
    "@tanstack/react-query": "5.104.5",
    "hono": "4.13.13",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.64.0",
    "@cloudflare/vitest-plugin": "1.4.6",
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.4",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "4.1.12",
    "workbox-window": "7.4.1",
    "wrangler": "4.151.3"
  }
}
